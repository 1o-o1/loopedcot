# results and logs stay local; only the job list travels
artifacts/*
!artifacts/manifest.json
# results travel: every grid (natural and forced), job records, score tables, allocator runs, live checks;
# generation checkpoints (trace_*), queue state and figures stay local
!artifacts/cells_*.jsonl
!artifacts/meta_*.json
!artifacts/score_*.json
!artifacts/alloc_*/
!artifacts/alloc_*_all_tables_*.md
!artifacts/live_*.json
logs/
__pycache__/
*.pyc
*.slim.jsonl
.pytest_cache/
# the trained-checkpoint block (S33) is not part of this queue; its assets are versioned separately
s33/
# validation gates and their record: run against the research harness, not from this repo
prod/gates/
checks.json
# local environment and model cache created by setup_env.sh
.venv/
hf/
*.tgz
# the operator's own cluster scripts (copies of slurm/*.sbatch with local partition, account, env)
*.slurm
slurm_script.sh
# gate outputs written to the root by prod.gates.* runs
/g3_score.json
/g4_cost.json
/g0_report*.md
